# Copy to .env and fill in. Never commit .env.

# --- runtime ---
GIGBID_PROFILE=open                 # open | open_alt | local | paid
GIGBID_RAG_VARIANT=v8_corrective    # overrides agent/config.yaml rag.variant
MARKETPLACE_MODE=gigsim             # gigsim | upwork_live

# --- model providers (open profile uses Groq-hosted open-weight models) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# --- infra ---
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
GIGSIM_URL=http://localhost:8100
GIGSIM_ADMIN_KEY=                   # admin key for GigSim (grading/evals only)
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173

# --- MCP servers (streamable HTTP) ---
PORTFOLIO_MCP_URL=http://localhost:8201/mcp
MARKETPLACE_MCP_URL=http://localhost:8202/mcp
WORKSPACE_MCP_URL=http://localhost:8203/mcp
MCP_BEARER_TOKEN=                   # shared secret the agent presents to our MCP servers

# --- auth / crypto ---
JWT_SECRET=                         # random 32+ chars
TOKEN_ENCRYPTION_KEY=               # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=

# --- live mode (optional) ---
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/auth/upwork/callback
GITHUB_PERSONAL_ACCESS_TOKEN=       # read-only token for the GitHub MCP server (repo ingestion)

# --- tracing (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
