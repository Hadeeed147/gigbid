{
 "create_email_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "body": {
     "maxLength": 5000,
     "title": "Body",
     "type": "string"
    },
    "idempotency_key": {
     "maxLength": 128,
     "minLength": 8,
     "title": "Idempotency Key",
     "type": "string"
    },
    "subject": {
     "maxLength": 200,
     "title": "Subject",
     "type": "string"
    },
    "to_name": {
     "maxLength": 120,
     "title": "To Name",
     "type": "string"
    }
   },
   "required": [
    "to_name",
    "subject",
    "body",
    "idempotency_key"
   ],
   "title": "create_email_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "body": {
     "title": "Body",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "status": {
     "default": "draft",
     "title": "Status",
     "type": "string"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    },
    "to_name": {
     "title": "To Name",
     "type": "string"
    }
   },
   "required": [
    "id",
    "to_name",
    "subject",
    "body"
   ],
   "title": "Draft",
   "type": "object"
  }
 },
 "create_interview_hold": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "duration_minutes": {
     "default": 30,
     "maximum": 120,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "idempotency_key": {
     "default": "",
     "maxLength": 128,
     "minLength": 8,
     "title": "Idempotency Key",
     "type": "string"
    },
    "start": {
     "description": "ISO start time from free_slots",
     "title": "Start",
     "type": "string"
    },
    "title": {
     "default": "Client interview (tentative)",
     "maxLength": 120,
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "start"
   ],
   "title": "create_interview_holdArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "end": {
     "title": "End",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "start": {
     "title": "Start",
     "type": "string"
    },
    "status": {
     "default": "tentative",
     "title": "Status",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "id",
    "start",
    "end",
    "title"
   ],
   "title": "Hold",
   "type": "object"
  }
 },
 "free_slots": {
  "annotations": {
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "properties": {
    "days_ahead": {
     "default": 5,
     "maximum": 14,
     "minimum": 1,
     "title": "Days Ahead",
     "type": "integer"
    },
    "duration_minutes": {
     "default": 30,
     "maximum": 120,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "max_slots": {
     "default": 3,
     "maximum": 10,
     "minimum": 1,
     "title": "Max Slots",
     "type": "integer"
    }
   },
   "title": "free_slotsArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "Slot": {
     "properties": {
      "end": {
       "title": "End",
       "type": "string"
      },
      "start": {
       "title": "Start",
       "type": "string"
      },
      "timezone": {
       "title": "Timezone",
       "type": "string"
      }
     },
     "required": [
      "start",
      "end",
      "timezone"
     ],
     "title": "Slot",
     "type": "object"
    }
   },
   "properties": {
    "slots": {
     "items": {
      "$ref": "#/$defs/Slot"
     },
     "title": "Slots",
     "type": "array"
    }
   },
   "required": [
    "slots"
   ],
   "title": "SlotList",
   "type": "object"
  }
 }
}