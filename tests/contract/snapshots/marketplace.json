 "create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "ai_assisted": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ai Assisted"
    },
    "bid_amount": {
     "exclusiveMinimum": 0,
     "maximum": 100000,
     "title": "Bid Amount",
     "type": "number"
    },
    "cover_letter": {
     "maxLength": 5000,
     "minLength": 50,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Unique per intended action; retries with the same key never repeat it",
     "maxLength": 128,
     "minLength": 8,
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "maxLength": 2000,
      "type": "string"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "bid_amount",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "title": "Idempotency Key",
     "type": "string"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "result": {
     "additionalProperties": true,
     "title": "Result",
     "type": "object"
    }
   },
   "required": [
    "idempotency_key",
    "result"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
