{
 "get_case_study": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "properties": {
    "item_id": {
     "maxLength": 120,
     "minLength": 3,
     "title": "Item Id",
     "type": "string"
    }
   },
   "required": [
    "item_id"
   ],
   "title": "get_case_studyArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "item_id": {
     "title": "Item Id",
     "type": "string"
    },
    "project_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Project Id"
    },
    "related_items": {
     "items": {
      "type": "string"
     },
     "title": "Related Items",
     "type": "array"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "item_id",
    "title",
    "text",
    "related_items"
   ],
   "title": "CaseStudy",
   "type": "object"
  }
 },
 "list_skills": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "properties": {},
   "title": "list_skillsArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "SkillCount": {
     "properties": {
      "evidence_items": {
       "title": "Evidence Items",
       "type": "integer"
      },
      "name": {
       "title": "Name",
       "type": "string"
      },
      "skill": {
       "title": "Skill",
       "type": "string"
      }
     },
     "required": [
      "skill",
      "name",
      "evidence_items"
     ],
     "title": "SkillCount",
     "type": "object"
    }
   },
   "properties": {
    "skills": {
     "items": {
      "$ref": "#/$defs/SkillCount"
     },
     "title": "Skills",
     "type": "array"
    }
   },
   "required": [
    "skills"
   ],
   "title": "SkillList",
   "type": "object"
  }
 },
 "search_evidence": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "$defs": {
    "SearchFilters": {
     "properties": {
      "outcome": {
       "anyOf": [
        {
         "enum": [
          "won",
          "replied",
          "ignored"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Proposals only",
       "title": "Outcome"
      },
      "project_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Project Id"
      },
      "since": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Only items dated on/after this ISO date",
       "title": "Since"
      },
      "types": {
       "description": "Restrict to these evidence types",
       "items": {
        "enum": [
         "case_study",
         "readme",
         "code",
         "review",
         "cv",
         "proposal"
        ],
        "type": "string"
       },
       "title": "Types",
       "type": "array"
      }
     },
     "title": "SearchFilters",
     "type": "object"
    }
   },
   "properties": {
    "filters": {
     "anyOf": [
      {
       "$ref": "#/$defs/SearchFilters"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "k": {
     "default": 5,
     "maximum": 20,
     "minimum": 1,
     "title": "K",
     "type": "integer"
    },
    "requirement": {
     "description": "One job requirement, e.g. 'nightly report queue with retries'",
     "maxLength": 500,
     "minLength": 2,
     "title": "Requirement",
     "type": "string"
    }
   },
   "required": [
    "requirement"
   ],
   "title": "search_evidenceArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "EvidenceItem": {
     "properties": {
      "client_industry": {
       "default": "",
       "title": "Client Industry",
       "type": "string"
      },
      "date": {
       "default": "",
       "title": "Date",
       "type": "string"
      },
      "item_id": {
       "title": "Item Id",
       "type": "string"
      },
      "outcome": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Outcome"
      },
      "project_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Project Id"
      },
      "score": {
       "title": "Score",
       "type": "number"
      },
      "source": {
       "title": "Source",
       "type": "string"
      },
      "text": {
       "title": "Text",
       "type": "string"
      },
      "title": {
       "title": "Title",
       "type": "string"
      },
      "type": {
       "title": "Type",
       "type": "string"
      }
     },
     "required": [
      "item_id",
      "type",
      "title",
      "source",
      "score",
      "text"
     ],
     "title": "EvidenceItem",
     "type": "object"
    }
   },
   "properties": {
    "items": {
     "items": {
      "$ref": "#/$defs/EvidenceItem"
     },
     "title": "Items",
     "type": "array"
    },
    "requirement": {
     "title": "Requirement",
     "type": "string"
    },
    "support": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "supported | weak | none (corrective variant)",
     "title": "Support"
    },
    "variant": {
     "title": "Variant",
     "type": "string"
    }
   },
   "required": [
    "requirement",
    "variant",
    "items"
   ],
   "title": "EvidenceList",
   "type": "object"
  }
 }
}